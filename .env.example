# Canonical origin used for metadata, Open Graph URLs, robots.txt and the sitemap.
SITE_URL=https://ardenandshear.example

# The demo is noindex by default. Set to "true" only when you deliberately want it indexed.
ALLOW_INDEXING=false

# Social icons always show and default to each platform's homepage, so the links visibly work in the demo.
# Replace with real account URLs, or set a value to empty to make that icon static (non-clickable).
INSTAGRAM_URL=https://www.instagram.com/
FACEBOOK_URL=https://www.facebook.com/
TIKTOK_URL=https://www.tiktok.com/
